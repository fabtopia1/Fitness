# LifeDNA OS — Cloud Functions configuration.
#
# NONE of these belong in the client. Every value here is a credential that,
# in an APK, would be extractable in minutes (docs/19 §3, T-02).
#
# In production these live in Secret Manager and are bound to individual
# functions via the `secrets:` option, not in a .env file.

# --- AI providers -----------------------------------------------------------
ANTHROPIC_API_KEY=
AI_PROVIDER=live            # live | fake  (the emulator uses `fake`)
AI_DAILY_TOKEN_BUDGET_FREE=60000
AI_DAILY_TOKEN_BUDGET_PRO=250000

# --- OAuth: Google Calendar -------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- OAuth: Microsoft Graph -------------------------------------------------
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=
MS_TENANT=common

# --- Token encryption -------------------------------------------------------
# Refresh tokens are envelope-encrypted with this KMS key before they touch
# Firestore. They are never returned to a client under any circumstance.
KMS_KEY_NAME=projects/lifedna-prod/locations/europe-west1/keyRings/lifedna/cryptoKeys/oauth-tokens

# --- Third-party data -------------------------------------------------------
OPEN_FOOD_FACTS_USER_AGENT=LifeDNA-OS/1.0 (support@lifedna.os)

# --- Region -----------------------------------------------------------------
FUNCTIONS_REGION=europe-west1
