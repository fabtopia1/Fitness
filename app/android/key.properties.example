# Release signing for LifeDNA OS.
#
# Copy to android/key.properties and fill in. That file is gitignored and MUST
# NOT be committed — it names the passwords to your upload key.
#
# Generate the keystore once, and keep it somewhere you will still have it in
# two years. Losing it means you can never ship an update to the same Play
# listing again; there is no recovery, only a new app.
#
#   keytool -genkey -v \
#     -keystore ~/lifedna-upload-keystore.jks \
#     -storetype JKS \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -alias lifedna-upload
#
# Then copy it to android/app/upload-keystore.jks (also gitignored) so the
# relative storeFile below resolves.
#
# storeFile is resolved relative to android/app/, or may be absolute.

storeFile=upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=lifedna-upload
keyPassword=CHANGE_ME
