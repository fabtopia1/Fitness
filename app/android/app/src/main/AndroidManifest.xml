<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Permissions are limited to what the shipped code actually calls.
        Health Connect permissions are deliberately NOT declared: the native
        reader is not in this build, and declaring health permissions without
        using them fails Google Play's health data declaration. They are added
        together with the native module — see docs/mvp/09-testing-strategy.md
        and the Health sync screen inside the app.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Local reminders: supplement doses, task due times, rest timer. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Re-arms scheduled reminders after the device restarts. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
        No SCHEDULE_EXACT_ALARM. Every reminder is scheduled with
        AndroidScheduleMode.inexactAllowWhileIdle, which survives Doze and does
        not require the restricted exact-alarm permission on Android 14+.
    -->

    <!-- Progress photos are taken in-app and never leave the device. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <!--
            allowBackup is FALSE deliberately, and the two rules files exclude
            everything for the versions that read them instead.

            Hive boxes are AES-encrypted with a key held in the Android
            Keystore. Keystore keys are device-bound and non-exportable, so a
            box restored onto a new device arrives without the key that opens
            it — an unrecoverable state. The app re-downloads from the user's
            account instead, which is both correct and faster.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Applied while the Android process starts and the Flutter UI
                 initialises; afterwards it is the window background. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            flutter_local_notifications receivers. These MUST be declared here.
            The plugin's own AndroidManifest.xml (18.0.1) contains permissions
            ONLY — no receivers — so without these three the plugin cannot show
            a scheduled notification at all, and nothing re-arms after a
            reboot. Every reminder in the app goes through zonedSchedule, so
            the failure is total and silent: the schedule is stored, the alarm
            fires, and there is no component to receive it.

            Verified against the plugin's README and its own manifest, not
            assumed. Re-check both on every plugin upgrade.
        -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false" />
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- Re-arms reminders after the app is UPDATED, not just after
                     a reboot. Sideloading a new APK over the old one would
                     otherwise silently drop every pending reminder. -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
        <!--
            No ActionBroadcastReceiver: nothing in this app creates a
            notification with actions. Add it together with the first
            AndroidNotificationAction, not before.
        -->

        <!-- Notification appearance. A monochrome small icon is required:
             Android tints it and a coloured one renders as a white blob. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <!-- Opening claude.ai / copilot.microsoft.com from the AI Hub. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- Used by the Flutter engine's ProcessTextPlugin. -->
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>
</manifest>
