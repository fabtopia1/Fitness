<?xml version="1.0" encoding="utf-8"?>
<!--
    The window background while the process starts, before Flutter's first
    frame. It resolves @color/launch_background, which values-night overrides,
    so a dark-mode device never sees a white flash ahead of a dark UI.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
</layer-list>
