<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing this app stores may be backed up or transferred.

    Hive boxes are AES-encrypted with a key held in the Android Keystore, and
    Keystore keys are device-bound and non-exportable. A restored box would
    arrive without the key that opens it, which is unrecoverable. Excluding the
    data is the only correct answer; the app re-downloads from the user's
    account instead.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
