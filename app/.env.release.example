# Build-time configuration for a LifeDNA OS release.
#
#   cp app/.env.release.example app/.env.release   # gitignored
#   set -a && . app/.env.release && set +a
#   tool/verify_release.sh prod
#   tool/build_release.sh prod
#
# Nothing here is a secret in the cryptographic sense — every value ships
# inside the APK and is readable by anyone who unzips it. Firebase security
# rests on the Firestore rules and on Auth, not on these being hidden. They are
# kept out of git so a fork does not inherit our project, and so dev, staging
# and prod cannot be confused.

# ---- Firebase (console → Project settings → Your apps → Android) ----
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=

# ---- Google Sign-In ----
# The WEB client id, from Authentication → Sign-in method → Google → Web SDK
# configuration. NOT the Android client id: Firebase verifies the ID token
# against the web client, so an Android id produces a null token with a
# different cause and the same symptom.
GOOGLE_SERVER_CLIENT_ID_DEV=
GOOGLE_SERVER_CLIENT_ID_STAGING=
GOOGLE_SERVER_CLIENT_ID_PROD=

# Optional. Calendar falls back to the sign-in client when unset, which is
# correct for every project that uses one OAuth client.
GOOGLE_CALENDAR_CLIENT_ID=
