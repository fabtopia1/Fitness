# ---------- Flutter / Dart ----------
app/.dart_tool/
app/.packages
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/build/
app/.pub-cache/
app/.pub/
app/coverage/
**/*.g.dart
**/*.freezed.dart
**/*.mocks.dart
!**/doc_examples/**/*.g.dart

# ---------- Android ----------
app/android/.gradle/
app/android/local.properties
app/android/key.properties
!app/android/key.properties.example
app/android/app/upload-keystore.jks
# Every location Gradle's google-services plugin looks in, not just the root
# one: the per-flavour paths are where a three-environment project actually
# puts these, and they carry the same OAuth client details.
**/google-services.json
app/android/.cxx/

# ---------- iOS ----------
app/ios/Pods/
app/ios/.symlinks/
app/ios/Flutter/Flutter.framework
app/ios/Flutter/Flutter.podspec
app/ios/Flutter/Generated.xcconfig
app/ios/Flutter/flutter_export_environment.sh
app/ios/Runner/GoogleService-Info.plist

# ---------- Firebase ----------
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
**/serviceAccountKey.json
**/firebase_options.dart

# ---------- Cloud Functions ----------
functions/node_modules/
firebase/rules-test/node_modules/
firebase/rules-test/firebase-debug.log
firebase/rules-test/firestore-debug.log
functions/lib/
functions/.env
functions/.env.*
!functions/.env.example

# ---------- Secrets ----------
.env
.env.local
app/.env.release
!app/.env.release.example
*.pem
*.p12
secrets/

