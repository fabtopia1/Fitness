rules_version = '2';

// LifeDNA OS — Firestore security rules (MVP).
//
// Design:
//   1. Deny by default. The final catch-all is not a formality.
//   2. Every document lives under users/{uid}, so ownership is one comparison
//      and there is no path where one user's query can reach another's data.
//   3. The collection name is an allow-list, not a wildcard. A client bug (or
//      a tampered build) that invents a collection is rejected rather than
//      silently creating an unbudgeted, unindexed, unowned tree.
//   4. Deletes are refused everywhere. The client soft-deletes by writing a
//      `deletedAt` tombstone, which is what makes a second device converge
//      instead of resurrecting the record on its next pull.
//   5. Dates are ISO-8601 STRINGS, not Firestore timestamps. The offline
//      write path serialises to JSON for Hive and replays the identical
//      payload to Firestore, so the two stores never disagree about a type.
//      Rules that demanded `is timestamp` would reject every write this
//      client makes.
//
// Validation here is a backstop, not the primary check: the client validates
// at entry (see the form validators and the domain constructors). These rules
// exist for the case where the client is not ours.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function data() {
      return request.resource.data;
    }

    // Every collection the MVP client writes. Adding a feature means adding a
    // line here — deliberately, so schema growth is reviewed.
    function isMvpCollection(name) {
      return name in [
        'foods',
        'meals',
        'nutrition_logs',
        'supplements',
        'supplement_logs',
        'exercises',
        'workouts',
        'workout_sessions',
        'body_measurements',
        'tasks',
        'calendar_events',
        'notifications',
        'settings'
      ];
    }

    // ISO-8601 UTC, e.g. 2026-08-28T09:15:00.000Z. Bounded so a rogue client
    // cannot smuggle a megabyte into a date field.
    function isIsoDate(value) {
      return value is string
             && value.size() >= 20
             && value.size() <= 32;
    }

    function hasSyncFields() {
      return isIsoDate(data().updatedAt)
             && (!('deletedAt' in data()) || data().deletedAt == null
                 || isIsoDate(data().deletedAt));
    }

    // The client owns document ids (UUID v4, or a deterministic id derived
    // from a date). A payload whose `id` disagrees with its path would make
    // the local and remote copies diverge on the next pull.
    function idMatchesPath(docId) {
      return !('id' in data()) || data().id == docId;
    }

    // A single record is a handful of fields. Anything far past that is either
    // a bug or an attempt to use the database as free storage.
    function isReasonableSize() {
      return data().keys().size() <= 64;
    }

    function isBoundedString(field, maxLength) {
      return !(field in data())
             || data()[field] == null
             || (data()[field] is string && data()[field].size() <= maxLength);
    }

    function isBoundedNumber(field, minValue, maxValue) {
      return !(field in data())
             || data()[field] == null
             || (data()[field] is number
                 && data()[field] >= minValue
                 && data()[field] <= maxValue);
    }

    // ------------------------------------------------------- the user record

    match /users/{uid} {

      function isValidProfile() {
        return isIsoDate(data().updatedAt)
               && data().id == uid
               && isBoundedString('email', 320)
               && isBoundedString('displayName', 120)
               && isBoundedString('photoUrl', 2048)
               // Physiological bounds. These are the same limits the
               // onboarding form enforces; a value outside them would make
               // every derived target meaningless.
               && isBoundedNumber('heightCm', 0, 300)
               && isBoundedNumber('weightKg', 0, 500)
               && isBoundedNumber('targetWeightKg', 0, 500)
               && isBoundedNumber('leanMassKg', 0, 500)
               && isBoundedNumber('weeklyRateTargetPct', 0, 5)
               && isBoundedNumber('trainingDaysPerWeek', 0, 14)
               && isBoundedNumber('overrideKcal', 0, 20000)
               && isBoundedNumber('overrideProteinG', 0, 2000)
               && isBoundedNumber('overrideCarbsG', 0, 2000)
               && isBoundedNumber('overrideFatG', 0, 2000)
               && isBoundedNumber('overrideWaterMl', 0, 30000);
      }

      allow get, list: if isOwner(uid);
      allow create, update: if isOwner(uid) && isValidProfile();

      // Account deletion removes auth, storage and every sub-collection at
      // once. That is a privileged, audited operation, not a client write.
      allow delete: if false;

      // ------------------------------------------------ owned sub-collections

      match /{collection}/{docId} {

        function isValidDocument() {
          return isMvpCollection(collection)
                 && hasSyncFields()
                 && idMatchesPath(docId)
                 && isReasonableSize()
                 // Free text is bounded everywhere it appears.
                 && isBoundedString('title', 500)
                 && isBoundedString('name', 300)
                 && isBoundedString('note', 4000)
                 && isBoundedString('notes', 4000)
                 && isBoundedString('description', 4000)
                 && isBoundedString('location', 500)
                 // Measurement and nutrition magnitudes.
                 && isBoundedNumber('kcal', 0, 100000)
                 && isBoundedNumber('proteinG', 0, 10000)
                 && isBoundedNumber('carbsG', 0, 10000)
                 && isBoundedNumber('fatG', 0, 10000)
                 && isBoundedNumber('weightKg', 0, 500)
                 && isBoundedNumber('quantityG', 0, 100000)
                 && isBoundedNumber('millilitres', 0, 30000)
                 && isBoundedNumber('hour', 0, 23)
                 && isBoundedNumber('minute', 0, 59);
        }

        allow get, list: if isOwner(uid) && isMvpCollection(collection);
        allow create, update: if isOwner(uid) && isValidDocument();

        // Soft delete only: the client writes a tombstone so other devices
        // converge. A hard delete would come back on their next pull.
        allow delete: if false;
      }
    }

    // ------------------------------------------------------------- catch-all

    // Anything not matched above — including any future collection added to
    // the console by hand — is unreachable from a client.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
