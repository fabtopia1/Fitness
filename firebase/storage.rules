rules_version = '2';

// LifeDNA OS — Cloud Storage rules (MVP).
//
// The MVP uploads NOTHING. Progress photos are the only binary the app
// handles and they stay in the app's private directory on the device: they are
// the most sensitive data in the product, and not uploading them is a stronger
// guarantee than any rule written here.
//
// These rules therefore deny everything. They exist so that the bucket is
// closed by default if it is ever provisioned, rather than inheriting a
// permissive template. When photo backup ships, this file gains a
// `/users/{uid}/photos/{photoId}` match with an owner check, a content-type
// check and a size cap — and not before.

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
